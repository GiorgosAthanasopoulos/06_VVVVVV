; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="06_VVVVVV"
config/description="VVVVVV clone."
run/main_scene="uid://b2gh6esf8gooh"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icons/godot/icon.svg"

[autoload]

Dialogs="*res://scripts/ui/utils/dialogs.gd"
SceneManager="*res://scripts/ui/utils/scene_manager.gd"
ColorController="*res://scripts/ui/utils/color_controller.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=1
shader_language/warnings/treat_warnings_as_errors=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor]

naming/node_name_num_separator=2
naming/node_name_casing=2
naming/script_name_casing=2
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[gui]

theme/custom_font="uid://by5mb5p4vx6lo"

[input]

ui_accept={
